# --- Dependencies & tooling ---
node_modules/
vendor/
.npm/
.cache/
.eslintcache
.stylelintcache
*.log
npm-debug.log*

# --- Secrets: NEVER commit ---
.env
.env.*
!.env.example
wp-config.php
*.pem
*.key
auth.json

# --- Internal starter tooling (not part of the public repo) ---
_project-helpers/
assembler/
media-for-front/

# --- Build artifacts we don't keep ---
assets/html/
assets/css/*.map
assets/js/*.map
assets/js/*.LICENSE.txt

# --- Docs, specs & design (local only) ---
# Everything except the public README
*.md
!/README.md
/design/
.agent-notes/
CLAUDE.md
.claude/

# --- Large / binary files ---
*.pdf
*.zip
*.psd
*.fig
*.mp4
*.mov
*.avi
*.tiff

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
